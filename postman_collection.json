          "raw": "{\n  \"user_id\": \"U001\",\n  \"device_id\": \"unknown_macbook_99\",\n  \"session_id\": \"hackathon_session_01\",\n  \"event_type\": \"login\",\n  \"metadata\": {\n    \"is_new_device\": true,\n    \"ip\": \"203.0.113.45\"\n  }\n}"
